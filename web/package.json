{
  "name": "avxxx-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "tsc --noEmit && react-router build",
    "typecheck": "tsc --noEmit && npm run i18n:check",
    "i18n:check": "node scripts/i18n-check.mjs",
    "start": "node server.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "favicon": "node scripts/favicon.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "hls.js": "1.7.3",
    "isbot": "5.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
