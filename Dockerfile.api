# Keep in step with the go directive in go.mod; bookworm matches the runtime image.
FROM golang:1.26.4-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/api ./cmd/api && CGO_ENABLED=0 go build -o /out/scheduler ./cmd/scheduler && CGO_ENABLED=0 go build -o /out/scraper ./cmd/scraper && CGO_ENABLED=0 go build -o /out/audit ./cmd/audit && CGO_ENABLED=0 go build -o /out/notifier ./cmd/notifier && CGO_ENABLED=0 go build -o /out/admin ./cmd/admin

FROM debian:bookworm-slim
# The slim image has no CA bundle or zoneinfo: without them every outbound HTTPS
# call (catalog crawl, media resolve, Web Push, SMTP STARTTLS) fails with
# "x509: certificate signed by unknown authority", and TZ names don't load.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /usr/share/zoneinfo /usr/share/zoneinfo
RUN useradd --system --create-home app
COPY --from=build /out/api /usr/local/bin/api
COPY --from=build /out/scheduler /usr/local/bin/scheduler
COPY --from=build /out/scraper /usr/local/bin/scraper
COPY --from=build /out/audit /usr/local/bin/audit
COPY --from=build /out/notifier /usr/local/bin/notifier
COPY --from=build /out/admin /usr/local/bin/admin
USER app
