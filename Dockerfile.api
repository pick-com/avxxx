FROM golang:1.24 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/api ./cmd/api && CGO_ENABLED=0 go build -o /out/scheduler ./cmd/scheduler && CGO_ENABLED=0 go build -o /out/scraper ./cmd/scraper && CGO_ENABLED=0 go build -o /out/audit ./cmd/audit

FROM debian:bookworm-slim
RUN useradd --system --create-home app
COPY --from=build /out/api /usr/local/bin/api
COPY --from=build /out/scheduler /usr/local/bin/scheduler
COPY --from=build /out/scraper /usr/local/bin/scraper
COPY --from=build /out/audit /usr/local/bin/audit
USER app
