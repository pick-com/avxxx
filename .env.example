DATABASE_URL=postgres://avxxx:avxxx@localhost:5432/avxxx?sslmode=disable
ADMIN_TOKEN=change-me
API_ADDR=127.0.0.1:8080
# Catalog crawler (cmd/scraper): contact URL or email sent in the User-Agent
# ("avxxx-catalog/0.2 (+contact)"). Required for catalog crawls; RSS feeds run without it.
CATALOG_CONTACT=
# Notifications (cmd/notifier). Leave a group empty to disable that channel.
BASE_URL=http://localhost:5173
# Web Push (VAPID). Generate with: go run ./cmd/notifier -gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT: mailto: or https: contact, e.g. mailto:ops@example.com
VAPID_SUBJECT=
# Comma-separated push service host suffixes; empty = major browsers, * = any https host.
PUSH_ALLOWED_HOSTS=
# Email over SMTP (STARTTLS required; port 465 = implicit TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFY_MAX_ATTEMPTS=6
