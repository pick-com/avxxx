DATABASE_URL=postgres://avxxx:avxxx@localhost:5432/avxxx?sslmode=disable
ADMIN_TOKEN=change-me
API_ADDR=127.0.0.1:8080
# Notifications (cmd/notifier). Leave a group empty to disable that channel.
BASE_URL=http://localhost:5173
# Web Push (VAPID). Generate with: go run ./cmd/notifier -gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT: mailto: or https: contact, e.g. mailto:ops@example.com
VAPID_SUBJECT=
# Comma-separated push service host suffixes; empty = major browsers, * = any https host.
PUSH_ALLOWED_HOSTS=
# Email over SMTP (STARTTLS required; port 465 = implicit TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFY_MAX_ATTEMPTS=6
# Playback provider linking (internal/medialink). The hourly media_link job
# (cmd/scheduler enqueues, cmd/audit runs) maps releases to Javtiful ahead of time.
# MEDIA_LINK_ON_DEMAND=false: the API never searches the provider on a page
# view; playback is 404 until the job has linked the release.
MEDIA_LINK_ON_DEMAND=true
MEDIA_LINK_EVERY=1h
MEDIA_LINK_MIN_INTERVAL=2s
MEDIA_LINK_MAX_PER_RUN=200
MEDIA_LINK_DAILY_CAP=2000
# How long POST /api/resolve reuses a successful result (stream URLs expire; 0 disables).
MEDIA_RESOLVE_TTL=5m
