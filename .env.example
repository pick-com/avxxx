DATABASE_URL=postgres://avxxx:avxxx@localhost:5432/avxxx?sslmode=disable
ADMIN_TOKEN=change-me
API_ADDR=127.0.0.1:8080
# Logging (internal/obs): json (default, production) or text (development).
LOG_FORMAT=text
# debug | info | warn | error
LOG_LEVEL=info
# Key for the hashed user ids in logs; set a long random value in production
# so hashes are stable across restarts. Empty = random per process.
LOG_HASH_KEY=
# Prometheus /metrics listener. Each binary has its own default
# (api 127.0.0.1:9090, scheduler :9091, scraper :9092, audit :9093,
# notifier :9094); "off" disables. Do not set it here: make exports .env to
# every binary and they would collide on one port.
# METRICS_ADDR=
# Notifications (cmd/notifier). Leave a group empty to disable that channel.
BASE_URL=http://localhost:5173
# Web Push (VAPID). Generate with: go run ./cmd/notifier -gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT: mailto: or https: contact, e.g. mailto:ops@example.com
VAPID_SUBJECT=
# Comma-separated push service host suffixes; empty = major browsers, * = any https host.
PUSH_ALLOWED_HOSTS=
# Email over SMTP (STARTTLS required; port 465 = implicit TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFY_MAX_ATTEMPTS=6
