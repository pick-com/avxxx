DATABASE_URL=postgres://avxxx:avxxx@localhost:5432/avxxx?sslmode=disable
ADMIN_TOKEN=change-me
API_ADDR=127.0.0.1:8080
# Catalog crawler (cmd/scraper): contact URL or email sent in the User-Agent
# ("avxxx-catalog/0.2 (+contact)"). Required for catalog crawls; RSS feeds run without it.
CATALOG_CONTACT=
# Logging (internal/obs): json (default, production) or text (development).
LOG_FORMAT=text
# debug | info | warn | error
LOG_LEVEL=info
# Key for the hashed user ids in logs; set a long random value in production
# so hashes are stable across restarts. Empty = random per process.
LOG_HASH_KEY=
# Prometheus /metrics listener. Each binary has its own default
# (api 127.0.0.1:9090, scheduler :9091, scraper :9092, audit :9093,
# notifier :9094); "off" disables. Do not set it here: make exports .env to
# every binary and they would collide on one port.
# METRICS_ADDR=
# Notifications (cmd/notifier). Leave a group empty to disable that channel.
BASE_URL=http://localhost:5173
# Web Push (VAPID). Generate with: go run ./cmd/notifier -gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT: mailto: or https: contact, e.g. mailto:ops@example.com
VAPID_SUBJECT=
# Comma-separated push service host suffixes; empty = major browsers, * = any https host.
PUSH_ALLOWED_HOSTS=
# Email over SMTP (STARTTLS required; port 465 = implicit TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFY_MAX_ATTEMPTS=6
# DMM/FANZA Affiliate Web API (cmd/scraper adapter "dmm"). Both empty = the
# dmm sources stay disabled and any job for them fails as "not configured".
# Never commit real values; they are sent only to api.dmm.com and are
# redacted from logs, job errors and stored records.
# Verify first: go run ./cmd/scraper -dry-run -adapter dmm
DMM_API_ID=
# Affiliate ID ending in 990-999 (the API-use ID, e.g. yourname-990).
DMM_AFFILIATE_ID=
# ThePornDB API (adapter "theporndb", source_kind third_party_api): personal
# API token from theporndb.net, sent only to api.theporndb.net as
# "Authorization: Bearer"; never logged or stored. Empty = the theporndb
# source does nothing (crawl jobs fail as "not configured", the crosscheck
# job records not_configured). Used by cmd/scraper (discovery) and cmd/audit
# (crosscheck lookups). Verify first:
#   go run ./cmd/scraper -dry-run -adapter theporndb
THEPORNDB_API_TOKEN=
# Third-party cross-check job (internal/crosscheck; cmd/scheduler enqueues,
# cmd/audit runs): looks releases that miss fields or have open conflicts up
# by DVD code. The source's license gate, min_request_interval and daily page
# budget apply on top of these caps.
CROSSCHECK_EVERY=1h
CROSSCHECK_MAX_PER_RUN=100
CROSSCHECK_DAILY_CAP=1000
# Playback provider linking (internal/medialink). The hourly media_link job
# (cmd/scheduler enqueues, cmd/audit runs) maps releases to Javtiful ahead of time.
# MEDIA_LINK_ON_DEMAND=false: the API never searches the provider on a page
# view; playback is 404 until the job has linked the release.
MEDIA_LINK_ON_DEMAND=true
MEDIA_LINK_EVERY=1h
MEDIA_LINK_MIN_INTERVAL=2s
MEDIA_LINK_MAX_PER_RUN=200
MEDIA_LINK_DAILY_CAP=2000
# How long POST /api/resolve reuses a successful result (stream URLs expire; 0 disables).
MEDIA_RESOLVE_TTL=5m
# Alertmanager receivers (compose profile "monitoring"; docs/PRODUCTION_OPERATIONS.md
# 值班通知). All empty = Alertmanager starts but notifies nobody (logged).
# severity=page -> ALERT_WEBHOOK_URL + ALERT_EMAIL_TO + chat;
# severity=warning -> ALERT_WARNING_WEBHOOK_URL + ALERT_WARNING_EMAIL_TO + chat.
# Email reuses SMTP_* above; sender is ALERT_EMAIL_FROM or MAIL_FROM.
ALERT_WEBHOOK_URL=
ALERT_WARNING_WEBHOOK_URL=
ALERT_EMAIL_TO=
# Defaults to ALERT_EMAIL_TO.
ALERT_WARNING_EMAIL_TO=
ALERT_EMAIL_FROM=
# Optional chat: Slack-compatible incoming webhook and/or Telegram bot.
ALERT_SLACK_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# node_exporter textfile directory scripts/backup-db.sh writes backup metrics to.
BACKUP_METRICS_DIR=./backups/metrics
# Web (SSR) service (web/server.mjs; docker compose service "web").
# Public origin for canonical / hreflang / sitemap URLs; empty = BASE_URL,
# then the request's own origin.
PUBLIC_BASE_URL=
# true: the web server also forwards /api/* to the API (single upstream).
# Production should route /api/ to the API in the reverse proxy instead.
WEB_API_PROXY=true
# Host port of the web service (127.0.0.1 only).
WEB_PORT=3000
# How long the web server caches the sitemap lists (seconds).
SITEMAP_TTL_SECONDS=3600
# Catalog images (internal/images, docs/DATA_RETENTION_AND_IMAGES.md).
# S3-compatible object storage; empty S3_ENDPOINT disables images (API
# responses carry no cover/portrait, the image jobs do nothing). Local MinIO:
# docker compose --profile storage up -d minio, then S3_ENDPOINT=http://minio:9000
# inside compose (http://127.0.0.1:9000 is not published). Never commit real keys.
S3_ENDPOINT=
S3_BUCKET=avxxx-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PATH_STYLE=true
# Public image URLs. Default: the API serves /api/images/{key} (checks
# suppression on every request). S3_PUBLIC_BASE_URL: a CDN with origin access
# to the private bucket. IMAGE_URL_MODE=signed: presigned URLs on
# S3_PRESIGN_ENDPOINT (browser-reachable) valid S3_SIGNED_URL_TTL.
S3_PUBLIC_BASE_URL=
IMAGE_URL_MODE=proxy
S3_PRESIGN_ENDPOINT=
S3_SIGNED_URL_TTL=12h
# Image jobs (cmd/scheduler enqueues, cmd/audit runs). Downloads also need
# CATALOG_CONTACT and a source with images_allowed (PUT /api/admin/sources/{id}/images).
MEDIA_FETCH_EVERY=1h
MEDIA_PURGE_EVERY=1h
IMAGE_FETCH_MIN_INTERVAL=2s
IMAGE_FETCH_MAX_PER_RUN=200
IMAGE_MAX_BYTES=8388608
IMAGE_MAX_DIMENSION=1600
# Suppressed / taken-down images are deleted after this (at most 24h).
MEDIA_PURGE_AFTER=24h
