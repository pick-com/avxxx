# Copy to /opt/egress/.env. Only the credentials are required.
# The provider's DEDICATED OpenVPN credentials (Proton: dashboard > Account >
# OpenVPN/IKEv2), not the account login.
PICK_VPN_NAME=
PICK_VPN_PASSWORD=
# Where the avxxx checkout lives on this host, for building the image.
EGRESS_SRC=/opt/avxxx
# Free Proton plan: on. Paid plan: off.
VPN_FREE_ONLY=on
VPN_COUNTRIES=Japan
